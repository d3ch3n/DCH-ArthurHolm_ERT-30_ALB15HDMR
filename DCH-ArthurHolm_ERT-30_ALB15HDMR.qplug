-- DCH Arthur Holm ERT-30 ALB15HDMR Q-SYS Plugin

PluginInfo = {
  Name = "DCH~Arthur Holm~ERT-30 ALB15HDMR",
  Version = "1.2.0",
  BuildVersion = "1.2.0.0",
  Id = "8f4d8d6e-0a9a-4c6d-9d35-56df72fdbd86",
  Author = "DCH",
  Description = "Controls Arthur Holm / Albiral ALB15HDMR monitors through an ERT-30 AHnet IP interface."
}


function GetColor(props)
  return { 34, 88, 122 }
end

function GetPrettyName(props)
  return "Arthur Holm ERT-30 ALB15HDMR v" .. PluginInfo.Version
end

PageNames = { "Control", "Setup" }

function GetPages(props)
  local pages = {}
  for ix, name in ipairs(PageNames) do
  table.insert(pages, { name = name })
end

for address = 1, props["Monitor Count"].Value do
  table.insert(pages, { name = "Monitor " .. address })
end

  return pages
end

function GetModel(props)
  local model = {}
  table.insert(model, {
  Name = "ALB15HDMR via ERT-30",
  Value = "ALB15HDMR"
})

  return model
end

function GetProperties()
  local props = {}
  table.insert(props, {
  Name = "Debug Print",
  Type = "enum",
  Choices = { "None", "Tx/Rx", "Tx", "Rx", "Function Calls", "All" },
  Value = "None"
})

table.insert(props, {
  Name = "Default Port",
  Type = "integer",
  Min = 1,
  Max = 65535,
  Value = 2002
})

table.insert(props, {
  Name = "Poll Interval",
  Type = "integer",
  Min = 0,
  Max = 300,
  Value = 10
})

table.insert(props, {
  Name = "Monitor Count",
  Type = "integer",
  Min = 1,
  Max = 30,
  Value = 1
})

  return props
end

function GetPins(props)
  local pins = {}
  -- No component pins.

  return pins
end

function RectifyProperties(props)
  if props["Default Port"].Value < 1 then
  props["Default Port"].Value = 2002
elseif props["Default Port"].Value > 65535 then
  props["Default Port"].Value = 65535
end

if props["Poll Interval"].Value < 0 then
  props["Poll Interval"].Value = 0
end

if props["Monitor Count"].Value < 1 then
  props["Monitor Count"].Value = 1
elseif props["Monitor Count"].Value > 30 then
  props["Monitor Count"].Value = 30
end

  return props
end

function GetComponents(props)
  local components = {}
  -- No internal Q-SYS components.

  return components
end

function GetWiring(props)
  local wiring = {}
  -- No internal Q-SYS wiring.

  return wiring
end

